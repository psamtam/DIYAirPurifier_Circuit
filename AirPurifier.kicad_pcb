	(gr_text "It all started with hay fever in spring 2026, \nfollowed by a trip back to Hong Kong in May, \nwhere air pollution made things a DISASTER. \nThe symptoms stuck around until August.\n"
		(at 203 57 0)
		(layer "B.SilkS")
		(uuid "089bd63e-fd1d-4cc2-8bfe-bad9820e227b")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "I just wanted an air purifier that moved plenty of air without \ncosting a fortune to buy or maintain. It also had to be \ncompact, minimalist, and durable (abusable), \nwith only the features that actually matter. \n\nSo I decided to build my own!\n\nEight fans. IKEA filters. Custom electronics.\nWhen in doubt, brute-force the airflow.\nQuiet, efficient.\nMaybe even a circulation fan too.\n\nNecessity sparked the idea. \nDissatisfaction drove the design.\nLife is just one problem to solve after another..."
		(at 217 83 0)
		(layer "B.SilkS")
		(uuid "d44f98ba-6d74-44fe-96ad-d71c3e3407b2")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "Designed & Engineered by Sam Tam\nDesigned in Nottingham, UK · Aug-Oct 2026\nAssembled in Hong Kong · Nov 2026"
		(at 227 128 0)
		(layer "B.SilkS")
		(uuid "ec5e03b3-855f-48c9-b5b4-726fa1425e0e")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "FILTER SYSTEM\nVacuumable Pre-filters\nIKEA STARKVIND EPA12 Filters\nOptional Activated-Carbon Filters\n\nMAINTENANCE\nClean the pre-filters regularly.\nReplace EPA12 filters when needed.\n\nWARNING\nA MASTERPIECE OF MULTI-ORIGIN.\nYOU'LL BE HAPPY JUST LOOKING AT IT."
		(at 130 83.5 0)
		(layer "B.SilkS")
		(uuid "3532fcc8-6afd-41a3-872e-8703f727f56f")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify right bottom mirror)
		)
	)
	(gr_text "MODEL: I DON'T CARE\nREV: HOPEFULLY FINAL\n\nELECTRICAL RATING\nInput: 220-240 V AC\nInternal Supply: 12 V DC\nMaximum Power: 60 W"
		(at 162.5 64.4 0)
		(layer "B.SilkS")
		(uuid "ada64f3d-f01d-46bd-a7f4-2958ef506c44")
		(effects
			(font
				(size 1 1)
				(thickness 0.125)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "DIY AIR PURIFIER WITH\n8 HIGH-STATIC-PRESSURE PC FANS\n"
		(at 162.5 52.5 0)
		(layer "B.SilkS")
		(uuid "fad34703-e397-4e69-a863-b1b423ad4232")
		(effects
			(font
				(size 1 1)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "THE STORY"
		(at 203 50 0)
		(layer "B.SilkS")
		(uuid "53e88fc9-8e3a-45e0-babc-de27bedc81de")
		(effects
			(font
				(size 1.3 1.3)
				(thickness 0.2)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "# IF I CAN'T SOURCE IT, I BUILD IT!"
		(at 198.65 99.95 0)
		(layer "B.SilkS")
		(uuid "4ee008d7-b57c-465a-b9b8-6fcef762c6e8")
		(effects
			(font
				(size 3 2.5)
				(thickness 0.4)
				(bold yes)
			)
			(justify left bottom mirror)
		)
	)
	(gr_text "DESIGN GOALS\n- Quiet operation\n- Affordable\n- Built to last\n\nFEATURES\n- 8× Fan PWM\n- LED PWM\n- Real-Time Clock (RTC)\n- Temperature Sensing\n- Humidity Sensing\n- Barometric Pressure\n- PM1.0 / PM2.5 / PM10"
		(at 101.8 126 0)
		(layer "User.1")
		(uuid "3934172e-7d63-4346-891b-9a07823eba78")
		(effects
			(font
				(size 1 1)
				(thickness 0.1)
			)
			(justify left bottom)
		)
	)
